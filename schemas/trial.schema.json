{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "stage",
    "name"
  ],
  "properties": {
    "stage": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    }
  }
}
